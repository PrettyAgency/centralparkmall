<?xml version="1.0" encoding="UTF-8"?>
<!--
  Central Park Mall - IIS configuration for the static site.
  Requires the IIS URL Rewrite module (https://www.iis.net/downloads/microsoft/url-rewrite).
  Without it, IIS returns a 500 error for every request.
-->
<configuration>
  <system.webServer>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rewriteMaps>
        <!-- Old Kentico category ids (?category=N) to the new filtered directory URLs -->
        <rewriteMap name="CategoryMap" defaultValue="">
        <add key="11" value="/shop/?category=Groceries%20%26%20Convenience" />
        <add key="6" value="/shop/?category=Fashion" />
        <add key="10" value="/shop/?category=Health%20%26%20Beauty" />
        <add key="9" value="/shop/?category=Services" />
        <add key="22" value="/shop/" />
        <add key="38" value="/shop/?category=Vending" />
        <add key="19" value="/eat/?category=Casual%20Dining%20%26%20Takeaway" />
        <add key="21" value="/eat/?category=Caf%C3%A9s" />
        <add key="18" value="/eat/?category=Restaurants" />
        <add key="37" value="/eat/?category=Bars" />
        <add key="35" value="/play/?category=Arts%20%26%20Culture" />
        <add key="34" value="/play/?category=Entertainment" />
        </rewriteMap>
        <!-- Old Kentico page URLs to their new equivalents (case-insensitive) -->
        <rewriteMap name="LegacyMap" defaultValue="">
        <add key="/Home" value="/" />
        <add key="/Shop" value="/shop/" />
        <add key="/Shop/Central-Park-Mall" value="/shop/" />
        <add key="/Shop/Everyday-Shopping" value="/shop/" />
        <add key="/Shop/Fashion-and-Homewares" value="/shop/?category=Fashion" />
        <add key="/Shop/Dining-and-Food" value="/eat/" />
        <add key="/Shop/News-Events" value="/whats-on/" />
        <add key="/Eat" value="/eat/" />
        <add key="/Eat/Central-Park-Mall" value="/eat/" />
        <add key="/Play" value="/play/" />
        <add key="/What-s-On" value="/whats-on/" />
        <add key="/Events" value="/whats-on/" />
        <add key="/Events/The-Japan-Foundation" value="/play/the-japan-foundation/" />
        <add key="/Events/Jaycar-Maker-Hub-October-Monthly-Workshops" value="/whats-on/" />
        <add key="/What-s-On/Palace-Central" value="/play/palace-central/" />
        <add key="/What-s-On/The-Japan-Foundation" value="/play/the-japan-foundation/" />
        <add key="/What-s-On/Vivid-Sydney" value="/whats-on/vivid-sydney/" />
        <add key="/What-s-On/Central-Park-Moon-Festival" value="/whats-on/" />
        <add key="/What-s-On/EXCLUSIVE-VOUCHER-GIVEAWAY" value="/whats-on/" />
        <add key="/What-s-On/Wingstop-has-arrived!" value="/eat/wingstop/" />
        <add key="/What-s-On/Proud-Poppy-Clothing-Pop-Up" value="/whats-on/" />
        <add key="/What-s-On/Game-Credit-Deals-at-Timezone" value="/play/timezone/" />
        <add key="/Location" value="/visit/" />
        <add key="/Development/Leasing-Enquiries" value="/leasing/" />
        <add key="/Leasing/Leasing-Enquiries" value="/leasing/" />
        <add key="/Leasing" value="/leasing/" />
        <add key="/Development/the-vision" value="/leasing/" />
        <add key="/Contact/Get-Social" value="/contact/" />
        <add key="/Contact/Thanks" value="/contact/" />
        <add key="/Shop/Thanks" value="/" />
        <add key="/CN-page" value="/zh/" />
        <add key="/Privacy-Policy" value="/privacy/" />
        <add key="/Disclaimer" value="/privacy/" />
        <add key="/Search" value="/shop/" />
        <add key="/Category" value="/shop/" />
        <add key="/Connor-Lead" value="/" />
        <add key="/Connor-Friends-of-Frasers" value="/" />
        <add key="/_Chapter-Page-Example" value="/" />
        <add key="/Robots" value="/" />
        <add key="/live/property-finder" value="/" />
        <add key="/Shops" value="/shop/" />
        <add key="/TOMRA-bottle-recycling" value="/shop/return-and-earn/" />
        <add key="/Anytime-Fitness-Central-Park-Mall" value="/shop/anytime-fitness/" />
        <add key="/Shops/Rococo-Seoul" value="/shop/rococo-seoul/" />
        <add key="/Shop/Central-Park-Mall/Hype-DC" value="/shop/hype-dc/" />
        <add key="/Shop/Central-Park-Mall/W-Cosmetics" value="/shop/w-cosmetics/" />
        <add key="/Shop/Everyday-Shopping/Amazing-Asian-Market" value="/shop/amazing-asian-market/" />
        <add key="/Shop/Everyday-Shopping/Daiso" value="/shop/daiso-japan/" />
        <add key="/Shop/Everyday-Shopping/Massage-World" value="/shop/massage-world/" />
        <add key="/Shop/Everyday-Shopping/MyHealth-Medical-Centre" value="/shop/myhealth-medical-centre/" />
        <add key="/Shop/Everyday-Shopping/Priceline-Pharmacy" value="/shop/priceline-pharmacy/" />
        <add key="/Shop/Everyday-Shopping/Red-Bottle" value="/shop/red-bottle/" />
        <add key="/Shop/Everyday-Shopping/WOOLWORTHS-METRO" value="/shop/woolworths-metro/" />
        <add key="/Shop/Everyday-Shopping/Chef-s-Academy" value="/shop/chefs-academy/" />
        <add key="/Shop/Everyday-Shopping/ProfessioNail" value="/shop/professionail/" />
        <add key="/Shop/Everyday-Shopping/Chewy-Chews" value="/shop/chewy-chews/" />
        <add key="/Shop/Everyday-Shopping/Book-Vendi" value="/shop/book-vendi/" />
        <add key="/Eat/Central-Park-Mall/Anita-Gelato" value="/eat/anita-gelato/" />
        <add key="/Eat/Central-Park-Mall/Bamboo-House" value="/eat/sunny-bamboo-house/" />
        <add key="/Eat/Central-Park-Mall/Machi-Machi" value="/eat/machi-machi/" />
        <add key="/Eat/Central-Park-Mall/Sushi-Naya" value="/eat/sushi-naya/" />
        <add key="/Eat/Central-Park-Mall/Twelve-Squares" value="/eat/twelve-squares/" />
        <add key="/Eat/Central-Park-Mall/UOBEI" value="/eat/uobei/" />
        <add key="/Eat/Central-Park-Mall/Fresh-Hot-Ma-La-Tang" value="/eat/fresh-hot-ma-la-tang/" />
        <add key="/Eat/Central-Park-Mall/Ma-La-Tang" value="/eat/fresh-hot-ma-la-tang/" />
        <add key="/Eat/Central-Park-Mall/Sunny-Seafood-Restaurant" value="/eat/sunny-seafood-restaurant/" />
        <add key="/Eat/Central-Park-Mall/Cafe-ACRO" value="/eat/cafe-acro/" />
        <add key="/Eat/Central-Park-Mall/Top-Impression-Bakery" value="/eat/top-impression-bakery/" />
        <add key="/Eat/Central-Park-Mall/Jagalchi" value="/eat/jagalchi/" />
        <add key="/Eat/Central-Park-Mall/Wingstop" value="/eat/wingstop/" />
        <add key="/Eat/Central-Park-Mall/Spin-Panda" value="/eat/spin-panda-bbq/" />
        <add key="/Play/The-Japan-Foundation" value="/play/the-japan-foundation/" />
        <add key="/Play/Palace-Central" value="/play/palace-central/" />
        <add key="/Play/Timezone" value="/play/timezone/" />
        <add key="/Play/Fortress-Sydney" value="/play/fortress-sydney/" />
        <add key="/Play/2315-Bar" value="/play/2315-bar/" />
        </rewriteMap>
      </rewriteMaps>
      <rules>
        <!-- 1. Force HTTPS and www for the production domain only (local and staging hosts are left alone) -->
        <rule name="Canonical host and HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_HOST}" pattern="^centralparkmall\.com\.au$" />
            <add input="{HTTP_HOST}{HTTPS}" pattern="^www\.centralparkmall\.com\.auoff$" />
          </conditions>
          <action type="Redirect" url="https://www.centralparkmall.com.au/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. Old ?category=N links -->
        <rule name="Legacy category ids" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(?:^|&amp;)category=(\d+)(?:&amp;|$)" />
            <add input="{CategoryMap:{C:1}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>

        <!-- 3. Old Kentico page URLs (with or without .aspx). New URLs all end in "/", so they never match. -->
        <rule name="Legacy pages" stopProcessing="true">
          <match url="^(.*[^/])$" />
          <conditions>
            <add input="{LegacyMap:/{R:1}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Legacy pages (.aspx)" stopProcessing="true">
          <match url="^(.*)\.aspx$" />
          <conditions>
            <add input="{LegacyMap:/{R:1}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Old home page" stopProcessing="true">
          <match url="^(home|default)\.aspx$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Remove Server header">
          <match serverVariable="RESPONSE_Server" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".github" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

  </system.webServer>

  <!-- Images, CSS and JS: cache for 7 days. File names are not fingerprinted, so keep this modest. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
